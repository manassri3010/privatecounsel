# --- LLM server ---
# On a GPU server, vLLM runs inside docker compose:
LLM_BASE_URL=http://vllm:8000/v1
LLM_MODEL=Qwen/Qwen3-8B
VLLM_API_KEY=change-me
# vLLM image tag (decision 004). Use v0.32.0-cu129 if `nvidia-smi` shows a driver older than 580.
VLLM_TAG=v0.32.0
# Local development with Ollama, API run directly with uvicorn:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# Local development with Ollama, API run inside docker compose:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:3b

# Hugging Face token (Qwen3 isn't gated; a token only raises download rate limits)
HF_TOKEN=

# --- Database ---
POSTGRES_USER=privatecounsel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=privatecounsel
DATABASE_URL=postgresql://privatecounsel:change-me@db:5432/privatecounsel
